# ==============================================================================
# Dockerfile - Yhanko Educa (School Admin Frontend)
# Multi-stage, performant, secure, lightweight (Alpine + Standalone Next.js)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Stage: Common Node.js runtime and OS packages
# ------------------------------------------------------------------------------
FROM node:20-alpine AS base

# Install libc6-compat for Alpine compatibility with Next.js SWC / binary extensions
RUN apk add --no-cache libc6-compat
WORKDIR /app

# ------------------------------------------------------------------------------
# 2. Dependencies Stage: Install project dependencies with caching
# ------------------------------------------------------------------------------
FROM base AS deps

# Copy dependency manifests first to leverage Docker layer caching
COPY package.json package-lock.json ./

# Install all dependencies (including devDependencies required for the build)
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit

# ------------------------------------------------------------------------------
# 3. Builder Stage: Build Next.js application in standalone mode
# ------------------------------------------------------------------------------
FROM base AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
# Copy all source files
COPY . .

# Environment Variables & Build Arguments
# These can be passed during build: `docker build --build-arg NEXT_PUBLIC_API_URL=...`
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG API_BASE_URL
ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
ARG NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
ARG NEXT_PUBLIC_APP_NAME

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    API_BASE_URL=$API_BASE_URL \
    NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=$NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME \
    NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=$NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# Run Next.js production build
RUN npm run build

# ------------------------------------------------------------------------------
# 4. Runner Stage: Production minimal runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

# Metadata labels
LABEL maintainer="Yhanko Tech" \
      project="school-admin" \
      description="Yhanko Educa School Admin Frontend"

# Production environment settings
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

# Security: Create non-root system user and group
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy entrypoint script and ensure execute permissions
COPY --chmod=755 docker-entrypoint.sh /app/docker-entrypoint.sh

# Copy public folder (static assets)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Copy standalone build output and static assets generated by Next.js
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Switch to unprivileged non-root user
USER nextjs

# Expose default application port
EXPOSE 3000

# Container Healthcheck (Checks /api/health with fallback to /)
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-3000}/api/health || \
      wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-3000}/ || exit 1

# Configure Entrypoint & Command
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["node", "server.js"]
