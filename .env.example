# ==============================================================================
# Exemplo de Configuração de Ambiente - Yhanko Educa (School Admin)
# Copie este arquivo para .env e preencha os valores correspondentes
# ==============================================================================

# URLs da API Backend (Endpoints de autenticação, turmas, alunos, pagamentos, etc.)
NEXT_PUBLIC_API_URL=https://school-api-production-a1c6.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://school-api-production-a1c6.up.railway.app
API_BASE_URL=https://school-api-production-a1c6.up.railway.app

# Integração Cloudinary (Opcional - Usado para upload direto de fotos de perfil)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Configurações Gerais da Aplicação
NEXT_PUBLIC_APP_NAME=Yhanko Educa

# Configurações de Execução (Servidor / Docker)
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
